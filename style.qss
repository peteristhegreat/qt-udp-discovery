QPushButton {
    padding: 20;
    margin: 10;
    /* font-family: "Times"; */
    font-size: 16pt;
    border-radius: 20px;
    border-style: inset;
    border-width: 2px;
    /*  min-width: 10em; */
    background: white;
}

QSlider::handle:vertical {
    height: 50px;
    width: 50px;
    padding: 25px;
    background: white;
    margin: 0 -25px; /* expand outside the groove */
    image: url(:/slider_handle.png);
}

 QPushButton:pressed {
     border-style: outset;
 }

